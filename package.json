{
  "name": "ut-ece",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@types/sql.js": "^1.4.11",
    "@vinext/cloudflare": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.10",
    "lucide-react": "^1.35.0",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "shadcn": "^4.19.0",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vazir-code-font": "^1.1.2",
    "vazirmatn": "^33.0.3",
    "vinext": "latest",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^26.4.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.127.1"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start --",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "db:schema:local": "wrangler d1 execute ut_ece_db --local --file=./schema.sql",
    "db:schema:remote": "wrangler d1 execute ut_ece_db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply ut_ece_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ut_ece_db --remote"
  }
}
